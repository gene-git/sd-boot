#!/usr/bin/bash
#
# test builds
# 
# Args:
#   [build_type [setup_type]]
#
# Must be run in the "src" directory doing:
# - Does a fresh build
# - initializes the test tree
# - installs the build into the test tree.
#
# build_type: one of the supported build types: Defaults to "release".
# It can be one of:
#   - release
#   - debug
#   - debugoptimized
#
# Setup_type defaults to "standard"
# It can be one of:
#   - standard
#   - valgrind
# 
# Note that some tests must be run serially.
# For example a test to add and then remove an item cannot be run at same time.
# The remove should be run after the add to ensure the remove path is fully tested.
# 

# -------------------------------------------------
# Options
#
build_type='release'
setup='standard'
cpu='baseline'

usage() {
    echo "do-test-build [build_type [setup [cpu]]"
    echo "  build_type: release or debug, debugoptimized or debugoptimized_nosan (release)"
    echo "  setup: set up test type: standard or valgrind (standard)"
    echo "  cpu: x86-64-v3. If not set then defaults to baseline"
    echo "    requires build_type and setup"
    echo "  Does a fresh build, installs to test tree and runs test suite"
    exit
}

#
# Options
# 
if [[ -n "$1" ]] ; then
    build_type="$1"
fi

if [[ -n "$2" ]] ; then
    setup="$2"
fi

if [[ -n "$3" ]] ; then
    cpu="$3"
fi

case "$build_type" in
    release|debug|debugoptimized|debugoptimized_nosan)
        ;;

    *)
        usage
        ;;
esac

case "$setup" in
    standard|valgrind)
        ;;
    *)
        usage
        ;;
esac

case "$cpu" in
    baseline|x86-64-v3)
        ;;
    *)
        usage
        ;;
esac

source_dir=$(/usr/bin/realpath ./)

# -------------------------------------------------
# Group tests into sets that can be run in parallel.
#
get_test_set() {
    local num="$1"
    local -n items="$2"

    case "$num" in
        1) 
            items=()
            items+=(sd-boot:boot_mounts_t1)
            items+=(sd-boot:efifs_t1)
            items+=(sd-boot:edk2-shell_t1)
            items+=(sd-boot:linux_t1)
            ;;

        2) 
            items=()
            items+=(sd-boot:efifs_t2)
            items+=(sd-boot:edk2-shell_t2)
            items+=(sd-boot:linux_t2)
            ;;

        3) 
            items=()
            items+=(sd-boot:edk2-shell_t3)
            items+=(sd-boot:linux_t3)
            ;;

        4) 
            items=()
            items+=(sd-boot:edk2-shell_t4)
            items+=(sd-boot:linux_t4)
            ;;
    esac
}

# -------------------------------------------------
# Build, install and run test sets
#

do_it() {
    local _btype="$1"
    local _libtype="$2"
    local -a _other
    _other=("${@:3}")

    echo "-------------------------------"
    echo " Building : $_btype"
    echo ""

    opts=(--reconfigure build/"$_btype")
    opts+=(--buildtype="$_btype")
    opts+=(-Ddefault_library="$_libtype")
    opts+=("${_other[@]}")
    opts+=("${options[@]}")

    bdir="$source_dir/build/$_btype"
    /usr/bin/rm -rf "$bdir"

    /usr/bin/meson setup "${opts[@]}"
    /usr/bin/meson compile -C build/"$_btype"

    ./tests/scripts/test-initialize "$_btype"

    echo "  ---------------"
    echo "  tests: $setup"
    echo ""

    declare -a test_set
    for i in {1..4}; do
        get_test_set "$i" test_set
        logbase="test-set-$i"

        /usr/bin/meson test "${test_set[@]}" -C build/"$_btype" --setup="$setup" --logbase "$logbase"
    done
    
}

# -------------------------------------------------
# Do what was asked
#
case "$build_type" in
    release) 
        do_it release shared  "-Dcpu_level=$cpu" "-Db_lto=true" "-Dhardened_export=true"
        ;;

    debug)
        do_it debug static "-Dstrip=false" "-Dcpu_level=$cpu"
        ;;

    debugoptimized)
        do_it debugoptimized static "-Dstrip=false" "-Db_sanitize=address,undefined" "-Dcpu_level=$cpu"
        ;;

    debugoptimized_nosan)
        # turn off sanitize when running perf 
        do_it debugoptimized static "-Dstrip=false" "-Db_sanitize=none" "-Dcpu_level=$cpu"
        ;;

    *)
        usage
esac

